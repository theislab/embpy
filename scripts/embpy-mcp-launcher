#!/bin/sh
# Start the embpy MCP server with a Python that has embpy installed.
#
# .claude-plugin/plugin.json names this script without an extension: Claude Code runs it
# on macOS and Linux, and embpy-mcp-launcher.cmd, which works the same way, on Windows.
# The first of these that can run the server starts it:
#
#   1. $EMBPY_PYTHON, the Python of an environment where embpy[mcp,models] is installed.
#      When it is set it is the only candidate: if it cannot run the server, the
#      launcher says why and stops.
#   2. The environment that uv installs embpy into with
#        uv tool install --python 3.12 --editable "<this repository>[mcp,models]"
#      (found through `uv tool dir`).
#   3. python3, then python, on PATH.
#
# embpy_mcp_check.py decides whether a candidate can run the server. When none can, the
# launcher prints the reason and what to do on stderr and, when an MCP client started it,
# also returns them as the error of the client's initialize request, so that
# `claude mcp list` and /mcp show them.
#
# Arguments are passed on to the server: `embpy-mcp-launcher --version` prints the
# version of embpy that the plugin would use. Apart from the interpreters and uv, the
# script uses only shell built-ins.

case $0 in
    */*) here=${0%/*} ;;
    *) here=. ;;
esac
here=$(CDPATH= cd "$here" && pwd -P)
root=${here%/*}
check=$here/embpy_mcp_check.py

say() {
    printf 'embpy-mcp-launcher: %s\n' "$1" >&2
}

# usable PYTHON: succeeds if PYTHON can run the server; otherwise $reason says why.
usable() {
    reason=$("$1" "$check" 2>&1) && return 0
    [ -n "$reason" ] || reason="it did not run"
    return 1
}

# start PYTHON HOW ARGS...: replace this shell with the server.
start() {
    python=$1
    say "starting the embpy MCP server with $python ($2)"
    shift 2
    exec "$python" -m embpy.mcp.server "$@"
}

# request_id LINE: the id of the JSON-RPC request on LINE, which is either second, after
# "jsonrpc", or last (Claude Code's initialize request).
request_id() {
    r=$1
    case $r in
        '{"jsonrpc"'*'"id"'*) r=${r#*'"id"'} ;;
        *'"id"'*) r=${r##*'"id"'} ;;
        *) echo 0 && return ;;
    esac
    while :; do
        case $r in
            ' '* | :*) r=${r#?} ;;
            *) break ;;
        esac
    done
    case $r in
        '"'*)
            r=${r#?}
            printf '"%s"\n' "${r%%'"'*}"
            ;;
        *)
            r=${r%%[!0-9]*}
            echo "${r:-0}"
            ;;
    esac
}

# json_text TEXT: TEXT for the inside of a JSON string.
json_text() {
    s=$1
    out=
    while [ -n "$s" ]; do
        rest=${s#?}
        c=${s%"$rest"}
        s=$rest
        case $c in
            \\ | \") out=$out\\$c ;;
            "$newline" | "$tab" | "$cr") out="$out " ;;
            *) out=$out$c ;;
        esac
    done
    printf '%s' "$out"
}
newline='
'
tab=$(printf '\t')
cr=$(printf '\r')

# fail MESSAGE: report MESSAGE and exit. When an MCP client started the launcher (stdin
# is not a terminal), answer each of its requests with MESSAGE as the error until it
# closes stdin. (Claude Code may first send a server/discover request, and after an error
# goes on with initialize; exiting right after a reply can lose it.)
fail() {
    say "$1"
    if [ ! -t 0 ]; then
        message=$(json_text "$1")
        answered=0
        while [ "$answered" -lt 5 ] && IFS= read -r request; do
            case $request in
                *'"id"'*) ;;
                *) continue ;; # a notification
            esac
            printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32000,"message":"%s"}}\n' \
                "$(request_id "$request")" "$message"
            answered=$((answered + 1))
        done
    fi
    exit 1
}

# 1. EMBPY_PYTHON
if [ -n "${EMBPY_PYTHON:-}" ]; then
    usable "$EMBPY_PYTHON" && start "$EMBPY_PYTHON" "EMBPY_PYTHON" "$@"
    fail "EMBPY_PYTHON is $EMBPY_PYTHON, but that Python cannot run the embpy MCP server: $reason. Install embpy there with: \"$EMBPY_PYTHON\" -m pip install \"embpy[mcp,models]\", or point EMBPY_PYTHON to another Python."
fi

tried=

# 2. The uv tool environment
if ! command -v uv >/dev/null 2>&1; then
    tried="$tried; uv: not installed"
elif tools=$(uv tool dir 2>/dev/null) && [ -n "$tools" ] && [ -d "$tools/embpy" ]; then
    for python in "$tools/embpy/bin/python" "$tools/embpy/Scripts/python.exe"; do
        [ -x "$python" ] || continue
        usable "$python" && start "$python" "uv tool environment" "$@"
        tried="$tried; $python: $reason"
    done
else
    tried="$tried; uv: no embpy tool environment"
fi

# 3. python3, then python, on PATH
for name in python3 python; do
    python=$(command -v "$name" 2>/dev/null) || continue
    # Without the developer tools, macOS's /usr/bin/python3 only opens a dialog offering
    # to install them.
    if [ "$python" = /usr/bin/python3 ] && [ -x /usr/bin/xcode-select ] &&
        ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
        tried="$tried; $python: needs the macOS command line developer tools"
        continue
    fi
    usable "$python" && start "$python" "$name on PATH" "$@"
    tried="$tried; $python: $reason"
done

fail "No Python found that can run the embpy MCP server (tried: ${tried#; }). Install embpy in a Python environment with: pip install \"embpy[mcp,models]\", then set EMBPY_PYTHON to that environment's python before starting Claude Code; or, with uv: uv tool install --python 3.12 --editable \"$root[mcp,models]\""
