# Repo-root pyproject.toml template for the workspace split (Part C).
# NOT applied to the real pyproject.toml in this PR; see
# migration_plan_part_c.md for the rationale.
#
# When the follow-up PR is ready to flip the layout:
#   cp docs/audit/pyproject.workspace.toml.template pyproject.toml
#   cp docs/audit/embpy.pyproject.toml.template      src/embpy/pyproject.toml
#   cp docs/audit/world_model.pyproject.toml.template src/world_model/pyproject.toml
# then run `pixi install -e gpu`.

[build-system]
build-backend = "hatchling.build"
requires = ["hatchling"]

[project]
name = "embpy-workspace"
version = "0.0.1"
description = "Workspace root for the embpy + world_model packages"
readme = "README.md"
requires-python = ">=3.11"

[tool.uv.workspace]
members = ["src/embpy", "src/world_model"]

# Carry over the workspace-wide tool configs that today live in the
# single pyproject.toml. ruff config is workspace-wide because both
# packages share the same line length / style.

[tool.hatch.metadata]
allow-direct-references = true

[tool.ruff]
line-length = 120
src = ["src/embpy/src", "src/world_model/src", "src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
xfail_strict = true
addopts = ["--import-mode=importlib"]
